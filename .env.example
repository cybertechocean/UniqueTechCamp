# ==============================================================================
# UniqueTechCamp Environment Variables (.env)
# ==============================================================================

# Core Django Settings
SECRET_KEY=generate_a_long_random_secret_key_for_production
DEBUG=False
ALLOWED_HOSTS=uniquetechcamp.org,www.uniquetechcamp.org,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://uniquetechcamp.org,https://www.uniquetechcamp.org
SECURE_SSL_REDIRECT=True

# Database Configuration (MariaDB / MySQL with utf8mb4 full emoji support)
# Option A: Individual DB Parameters (Recommended for cPanel / Shared Hosting)
DB_ENGINE=django.db.backends.mysql
DB_NAME=uniquetechcamp_db
DB_USER=uniquetechcamp_user
DB_PASSWORD=your_mariadb_password_here
DB_HOST=localhost
DB_PORT=3306

# Option B: Single DATABASE_URL (Alternative)
# DATABASE_URL=mysql://uniquetechcamp_user:your_password@localhost:3306/uniquetechcamp_db

# Email Configuration (Google App Password / SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=UniqueTechCamp@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_16_character_app_password
DEFAULT_FROM_EMAIL=UniqueTechCamp <info@uniquetechcamp.org>
SERVER_EMAIL=UniqueTechCamp <info@uniquetechcamp.org>
